# Copy this file to .env (same folder) and paste your keys after the = signs.
# .env stays on your computer. Never share it or paste a key into a chat.

# Used for the helper model: writing the buyer questions and reading each
# answer into a product list. Always needed.
OPENAI_API_KEY=

# Used to buy the ChatGPT answers themselves, by scraping, at about a
# fiftieth of what the OpenAI API charges for the same answer.
# Get one at console.apify.com/settings/integrations
# Only needed while config.ANSWER_SOURCE is "apify" (the default).
APIFY_TOKEN=

# Copy this file to .env and fill it in. The dialer reads it from this folder or from the
# folder you start it in. Never commit .env: it holds your Twilio and Close keys.

# --- Who may sign in ---------------------------------------------------------------------
# Comma-separated. Each person signs in with their address and an access key that
#   python -m parallel_dialer access-key EMAIL
# prints. Each address needs a different part before the @ (alice@example.com and alice@example.org
# would share keys and recordings, so the dialer refuses to start with both).
DIALER_ALLOWED_EMAILS=you@example.com

# --- Where the dialer is reached ----------------------------------------------------------
# Exactly what you type in the browser's address bar, and the address Twilio calls back.
# Twilio needs a public https address: a server with a domain, or a tunnel while you try
# it out (see README). Writes from the page are refused unless their Origin is this.
DIALER_PUBLIC_URL=http://127.0.0.1:8767
# Behind a reverse proxy on the same machine leave the host alone; inside Docker use 0.0.0.0.
#DIALER_HOST=127.0.0.1
#DIALER_PORT=8767
# Recordings, dial progress, saved keys and the signing secret live here. Back it up.
#DIALER_ROOT=./data
# Days a browser stays signed in.
#DIALER_SESSION_DAYS=14
# Signs sessions and derives access keys. Left empty, one is made on first run and kept in
# DIALER_ROOT/state/secret.key. Change it (or DIALER_TOKEN_VERSION) to sign everyone out
# and make every access key stop working.
#DIALER_SECRET=
#DIALER_TOKEN_VERSION=1
# Where dialer.toml is, if not ./dialer.toml.
#DIALER_CONFIG=./dialer.toml

# --- Twilio (https://console.twilio.com) --------------------------------------------------
TWILIO_ACCOUNT_SID=
# Account > API keys & tokens > Create API key (Standard). The secret is shown once.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# A voice-capable number on that account, as +E.164: the caller ID people see.
TWILIO_PHONE_NUMBER=

# --- Close CRM (https://app.close.com/settings/developer/api-keys/) ------------------------
# Your contacts come from Close Smart Views. This is the shared key. Each operator can also
# save their own from the gear icon on the page, or set CLOSE_API_KEY_<NAME> here, where
# NAME is the part of their address before the @, in capitals (CLOSE_API_KEY_ALICE).
CLOSE_API_KEY=

# --- Telling a person from a machine -------------------------------------------------------
# Phrase rules answer most calls; this key is used for the ones they cannot, and the dialer
# stays locked without it.
OPENAI_API_KEY=
#DIALER_LLM_MODEL=gpt-5-mini
# Optional: OpenRouter is tried before OpenAI when its key is set.
#OPENROUTER_API_KEY=
#OPENROUTER_MODEL=

# --- Safety switches ----------------------------------------------------------------------
# Signs Twilio's callbacks, at least 24 characters. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DIALER_WEBHOOK_TOKEN=
# Nothing dials until this says enabled.
DIALER_LIVE_MODE=
# The only numbers the dialer may call. Start with your own and a colleague's. To call your
# whole list, leave this empty and set DIALER_UNRESTRICTED=enabled instead.
DIALER_ALLOWED_TEST_NUMBERS=
#DIALER_UNRESTRICTED=enabled
# Never dialed, whatever the list says.
#DIALER_BLOCKED_NUMBERS=
# A phone that rings when an operator picks "My phone" instead of the browser (+E.164).
#DIALER_OPERATOR_NUMBER=
# Where a returning call rings. A Close Voice number puts the callback on the lead; without
# one it goes to DIALER_OPERATOR_NUMBER.
#DIALER_CALLBACK_NUMBER=

# --- Docker Compose only ------------------------------------------------------------------
# The domain Caddy gets a certificate for. Point its DNS at the machine first.
#DIALER_DOMAIN=dialer.example.com
